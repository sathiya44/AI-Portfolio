# Google Gemini API Key for client-side chat queries
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key for Email Delivery
RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_API_KEY=your_resend_api_key_here

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID (e.g. xxxxxxxxxx)
VITE_CLARITY_PROJECT_ID=xxxxxxxxxx

# Optional flag: set to true to force analytics to fire during local development testing
VITE_ENABLE_ANALYTICS=false
